# Server
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/the-prophet

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:4000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS — origin allowed to send credentialed requests
WEB_ORIGIN=http://localhost:5173

# Football data provider (leave blank to disable sync job)
FOOTBALL_API_KEY=
FOOTBALL_API_PROVIDER=

# reCAPTCHA (optional extra guard on sensitive routes)
RECAPTCHA_SECRET=

# JWT for device-token / managed-member access links
DEVICE_TOKEN_SECRET=change-me-device-secret

# Business rules
MAX_GROUPS_PER_ADMIN=10

# Comma-separated list of Google-authenticated emails that get isSuperAdmin=true on first login
SUPER_ADMIN_EMAILS=
